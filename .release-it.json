{
  "$schema": "https://unpkg.com/release-it@19/schema/release-it.json",
  "git": {
    "commitMessage": "chore(release): ${version}",
    "push": false
  },
  "npm": {
    "publish": false
  },
  "plugins": {
    "release-it-splunk-conf-bumper": {
      "path": "app/default/app.conf",
      "bumpBuild": {
        "on": "prerelease"
      },
      "manifestPath": "app/app.manifest"
    }
  }
}
